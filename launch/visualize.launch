<launch>
  <arg name="plot" default="true"/>
  <arg name="graph" default="true"/>
  <node if="$(arg plot)" pkg="rqt_plot" type="rqt_plot" name="circle_plot"
        args="/turtle1/cmd_vel/linear/x /turtle1/cmd_vel/angular/z" output="screen"/>
  <node if="$(arg graph)" pkg="rqt_graph" type="rqt_graph" name="circle_graph"
        output="screen"/>
</launch>
